      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const trim = v => (v ?? '').toString().trim();\nconst titleCase = s => trim(s).toLowerCase().replace(/\\b\\w/g, c => c.toUpperCase());\n\nconst courseMap = {\n  'python': 'Python',\n  'ml': 'Machine Learning',\n  'machine learning': 'Machine Learning',\n  'data science': 'Data Science'\n};\nconst course = trim($json.Course).toLowerCase();\n\n// convert DD-MM-YYYY to YYYY-MM-DD\nconst [d, m, y] = trim($json.Enrolled_Date).split('-');\nconst date = (d && m && y) ? `${y}-${m}-${d}` : '';\n\nreturn {\n  json: {\n    Student_ID: trim($json.Student_ID).toUpperCase(),\n    Name: titleCase($json.Name),\n    Email: trim($json.Email).toLowerCase(),\n    Phone: trim($json.Phone),\n    Course: courseMap[course] || titleCase(course),\n    Status: trim($json.Status).toLowerCase(),\n    City: titleCase($json.City),\n    Enrolled_Date: date\n  }\n};"
      },
